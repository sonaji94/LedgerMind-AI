# ============================================================
# LedgerMind AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- Application ----
APP_NAME=LedgerMind AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledgermind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ledgermind_db

# Assembled from the above — override to set a custom URI
# DATABASE_URL=postgresql+asyncpg://ledgermind:changeme@localhost:5432/ledgermind_db

# ---- Security ----
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- AI / LLM ----
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.1

# ---- ML ----
# MODEL_PATH=ml/models/fraud_model.joblib
# PREDICTION_THRESHOLD=0.5

# ---- Redis (optional, for caching) ----
# REDIS_URL=redis://localhost:6379/0
