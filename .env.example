# ============================================================
# LedgerMind AI — Enterprise Environment Configuration
# ============================================================
# Copy this file to .env and configure for your environment.
# NEVER commit the .env file with production secrets.
# ============================================================

# ---- Application ----
APP_NAME="LedgerMind AI"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS="*"

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- PostgreSQL Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledgermind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ledgermind_db

# Override if connecting via custom async connection string
# DATABASE_URL=postgresql+asyncpg://ledgermind:changeme@localhost:5432/ledgermind_db
# Set to true for zero-config local SQLite file development:
USE_SQLITE=true

# ---- Redis Velocity & Rate-Limit Cache ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ---- Security & Role-Based Access Control (RBAC) ----
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Machine Learning & TreeSHAP Pipeline ----
MODEL_PATH=ml/models/fraud_model.joblib
PREDICTION_THRESHOLD=0.50

# ---- Presentation Tier (Streamlit) ----
BACKEND_API_URL=http://localhost:8000/api/v1
