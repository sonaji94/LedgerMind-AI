{
  "openapi": "3.1.0",
  "info": {
    "title": "LedgerMind AI",
    "description": "AI-Powered Financial Analytics, Fraud Detection, and Intelligent Reporting Platform. All monetary values in integer minor units (e.g. 1050 = \u20ac10.50). Every journal transaction satisfies \u03a3 Debits = \u03a3 Credits.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login For Access Token",
        "description": "Issue a cryptographically signed HMAC-SHA256 JWT access token for API callers.\nUsed by analysts and upstream payment gateways to authorize transactions.",
        "operationId": "login_for_access_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Create Account",
        "description": "Create a new financial account and initialize its balance projection.",
        "operationId": "create_account_api_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_id}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Account",
        "description": "Retrieve an account by ID along with its live balance projection.",
        "operationId": "get_account_api_v1_accounts__account_id__get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_id}/transactions": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Account Transactions",
        "description": "Return a paginated list of all journal entries (debits and credits)\nfor the specified account, ordered newest-first.",
        "operationId": "get_account_transactions_api_v1_accounts__account_id__transactions_get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Account Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Results per page (max 100)",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Results per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Create Transfer",
        "description": "Execute an atomic, balanced transfer between accounts.\nGuarantees idempotency when an Idempotency-Key header is supplied.",
        "operationId": "create_transfer_api_v1_transfers_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fraud/predict": {
      "post": {
        "tags": [
          "Fraud Detection"
        ],
        "summary": "Predict Fraud",
        "description": "Score a transaction's features in real-time and return fraud risk probability with SHAP attribution.",
        "operationId": "predict_fraud_api_v1_fraud_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FraudPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FraudPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fraud/model-info": {
      "get": {
        "tags": [
          "Fraud Detection"
        ],
        "summary": "Get Model Info",
        "description": "Return active model metadata and optimal calibrated decision threshold.",
        "operationId": "get_model_info_api_v1_fraud_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Analytics Summary",
        "description": "Calculate platform-wide financial summary metrics via SQL aggregations.",
        "operationId": "get_analytics_summary_api_v1_analytics_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/ask": {
      "post": {
        "tags": [
          "AI Assistant"
        ],
        "summary": "Ask Financial Assistant",
        "description": "Answer financial questions grounded strictly in database records.\nUses parameterized, read-only analytical queries to prevent hallucinations.",
        "operationId": "ask_financial_assistant_api_v1_ai_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIAssistantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIAssistantResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Deep health check",
        "description": "Returns the operational status of the API, database connection,\nand ML fraud model. Safe for load-balancer probes.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIAssistantRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AIAssistantRequest"
      },
      "AIAssistantResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "grounded_data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Grounded Data"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "grounded_data",
          "timestamp"
        ],
        "title": "AIAssistantResponse"
      },
      "AccountCreateRequest": {
        "properties": {
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "initial_deposit_minor_units": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Initial Deposit Minor Units",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owner_id"
        ],
        "title": "AccountCreateRequest"
      },
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "balance_minor_units": {
            "type": "integer",
            "title": "Balance Minor Units"
          },
          "balance_major": {
            "type": "number",
            "title": "Balance Major"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "currency",
          "status",
          "balance_minor_units",
          "balance_major",
          "created_at"
        ],
        "title": "AccountResponse"
      },
      "AnalyticsSummaryResponse": {
        "properties": {
          "total_accounts": {
            "type": "integer",
            "title": "Total Accounts"
          },
          "total_transactions": {
            "type": "integer",
            "title": "Total Transactions"
          },
          "total_volume_minor_units": {
            "type": "integer",
            "title": "Total Volume Minor Units"
          },
          "total_volume_major": {
            "type": "number",
            "title": "Total Volume Major"
          },
          "average_transaction_major": {
            "type": "number",
            "title": "Average Transaction Major"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "total_accounts",
          "total_transactions",
          "total_volume_minor_units",
          "total_volume_major",
          "average_transaction_major",
          "currency"
        ],
        "title": "AnalyticsSummaryResponse"
      },
      "FraudPredictionRequest": {
        "properties": {
          "transaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Features"
          },
          "explain": {
            "type": "boolean",
            "title": "Explain",
            "description": "Whether to compute SHAP feature contributions",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "features"
        ],
        "title": "FraudPredictionRequest"
      },
      "FraudPredictionResponse": {
        "properties": {
          "transaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          },
          "risk_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score"
          },
          "is_suspicious": {
            "type": "boolean",
            "title": "Is Suspicious"
          },
          "threshold_applied": {
            "type": "number",
            "title": "Threshold Applied"
          },
          "model_type": {
            "type": "string",
            "title": "Model Type"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "top_shap_contributions": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Shap Contributions"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "risk_score",
          "is_suspicious",
          "threshold_applied",
          "model_type",
          "latency_ms"
        ],
        "title": "FraudPredictionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JournalEntryItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "transaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transaction Id"
          },
          "entry_type": {
            "type": "string",
            "title": "Entry Type"
          },
          "amount_minor_units": {
            "type": "integer",
            "title": "Amount Minor Units"
          },
          "amount_major": {
            "type": "number",
            "title": "Amount Major"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Posted At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "transaction_id",
          "entry_type",
          "amount_minor_units",
          "amount_major",
          "posted_at"
        ],
        "title": "JournalEntryItem",
        "description": "A single debit or credit leg of a journal transaction."
      },
      "LoginRequest": {
        "properties": {
          "client_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Id",
            "description": "Analyst or service client UUID"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role: admin, financial_analyst, auditor",
            "default": "financial_analyst"
          },
          "secret": {
            "type": "string",
            "minLength": 4,
            "title": "Secret",
            "description": "Client API secret key"
          }
        },
        "type": "object",
        "required": [
          "secret"
        ],
        "title": "LoginRequest"
      },
      "ModelInfoResponse": {
        "properties": {
          "model_type": {
            "type": "string",
            "title": "Model Type"
          },
          "optimal_threshold": {
            "type": "number",
            "title": "Optimal Threshold"
          },
          "features_count": {
            "type": "integer",
            "title": "Features Count"
          },
          "preprocessor_type": {
            "type": "string",
            "title": "Preprocessor Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "model_type",
          "optimal_threshold",
          "features_count",
          "preprocessor_type",
          "status"
        ],
        "title": "ModelInfoResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in_seconds": {
            "type": "integer",
            "title": "Expires In Seconds"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in_seconds"
        ],
        "title": "TokenResponse",
        "description": "Response returned upon successful authentication."
      },
      "TransactionHistoryResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/JournalEntryItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "page",
          "page_size",
          "total",
          "items"
        ],
        "title": "TransactionHistoryResponse",
        "description": "Paginated list of journal entries for a given account."
      },
      "TransferRequest": {
        "properties": {
          "source_account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Account Id"
          },
          "destination_account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Destination Account Id"
          },
          "amount_minor_units": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor Units",
            "description": "Amount in minor units (e.g. 1050 = \u20ac10.50)"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "EUR"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "title": "Description",
            "default": "Transfer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_account_id",
          "destination_account_id",
          "amount_minor_units"
        ],
        "title": "TransferRequest"
      },
      "TransferResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transaction Id"
          },
          "source_account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Account Id"
          },
          "destination_account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Destination Account Id"
          },
          "amount_minor_units": {
            "type": "integer",
            "title": "Amount Minor Units"
          },
          "amount_major": {
            "type": "number",
            "title": "Amount Major"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "posted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Posted At"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "source_account_id",
          "destination_account_id",
          "amount_minor_units",
          "amount_major",
          "currency",
          "description",
          "posted_at"
        ],
        "title": "TransferResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}